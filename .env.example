# Last.fm API key for genre suggestions. Create one at
# https://www.last.fm/api/account/create (no secret is needed).
LASTFM_API_KEY=

# Host folder holding the music library to review. It is mounted
# read-write at /library, because approved genres are written to the files.
MUSIC_LIBRARY=/home/you/Music/library

# Where the library folder sits inside MPD's music_directory, so MPD can be
# asked to rescan an album after its genres change. Leave empty when the
# library folder is MPD's music_directory itself.
MPD_PATH_PREFIX=library

# MPD connection (host networking, so 127.0.0.1 is the host's MPD).
MPD_HOST=127.0.0.1
MPD_PORT=6600
MPD_PASSWORD=

# Port for the review page (listens on 127.0.0.1 only).
PORT=18771

# Minutes between library rescans and Last.fm lookups; 0 scans only at start.
SCAN_INTERVAL_MINUTES=60

# Genres ticked by default per album (the best-scoring ones).
MAX_GENRES=3

# Lowest album-tag score (1-100) that Bulk accept offers.
BULK_MIN_WEIGHT=60

# Look up lyrics for new tracks on LRCLIB after each scan (1 = yes).
# Otherwise lyrics are only filled from the Lyrics page.
LYRICS_AUTO_FILL=0

# Most tracks to look up per scan when LYRICS_AUTO_FILL=1.
LYRICS_AUTO_LIMIT=300

# Time zone for times shown on the page (stored times are always UTC).
# Leave unset for UTC.
TZ=America/Chicago

# Ask Deezer for lyrics after LRCLIB (1 = yes): tracks LRCLIB had nothing
# for, and synced versions of ones it only had plain lyrics for.
DEEZER_LYRICS=0

# File holding the Deezer ARL login cookie, such as deemix's .arl (inside
# Docker, a mounted folder: see compose.yaml).
DEEZER_ARL_FILE=

# The ARL itself, used only when DEEZER_ARL_FILE is unset or empty.
DEEZER_ARL=
